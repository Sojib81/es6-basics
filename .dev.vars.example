# Copy to .dev.vars for local development (never commit .dev.vars).
NEXTJS_ENV=development
APP_ENV=local
ALERTS_MODE=log
# Local-only admin login bypass (Cloudflare Access isn't in front of localhost). Refused elsewhere.
DEV_ADMIN_EMAIL=owner@example.com
# Turnstile: leave unset locally (the form sends Cloudflare's dummy token, accepted offline).
# Shared secret between the Worker cron handler and /api/cron (any long random string).
CRON_SECRET=local-cron-secret-0123456789
# Webhook secret for inbound SMS (provider URL: /api/sms/inbound?secret=...)
SMS_INBOUND_SECRET=local-sms-secret-0123456789
# Stripe (deposits). Use test-mode keys outside production.
# STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_local_test_secret_0123456789
